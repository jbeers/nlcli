#!/bin/sh
# MatchBox swallows --version/-v/--help/-h before the script sees them.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -f "$here/nlcli.env" ]; then
	while IFS= read -r line || [ -n "$line" ]; do
		case "$line" in ''|\#*) continue ;; esac
		key=${line%%=*}
		val=${line#*=}
		key=$(printf '%s' "$key" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
		val=$(printf '%s' "$val" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
		case "$key" in ''|*[!A-Za-z0-9_]*) continue ;; esac
		export "$key=$val"
	done < "$here/nlcli.env"
fi
mb=${MATCHBOX:-$HOME/dev/ortus-boxlang/matchbox/target/debug/matchbox}
if [ ! -x "$mb" ]; then
	mb=$HOME/dev/ortus-boxlang/matchbox/target/release/matchbox
fi
if [ ! -x "$mb" ]; then
	echo "nlcli: matchbox not found (set MATCHBOX)" >&2
	exit 127
fi
if [ -t 1 ] || [ -t 2 ]; then
	COLUMNS=$(tput cols 2>/dev/null || printf 80)
	export COLUMNS
fi
case "$1" in
	--version|-v) exec "$mb" "$here/nlcli.bxs" -- --nlcli-version ;;
	--help|-h) exec "$mb" "$here/nlcli.bxs" -- --nlcli-help ;;
esac
exec "$mb" "$here/nlcli.bxs" -- "$@"
