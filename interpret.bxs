// interpret — NL → shell command. MatchBox runtime.

VERSION = "0.1.0"
RISK_THRESHOLD = 7

function usage() {
	systemOutput("usage: interpret [-n|--dry-run] [-y|--yes] [-e|--explain] [--history] <request>", true, true)
}

function flagOn(options, name) {
	if (!structKeyExists(options, name) || options[name] == false) {
		return false
	}
	return true
}

function swallowed(options, name, parts) {
	if (structKeyExists(options, name) && !isBoolean(options[name])) {
		arrayAppend(parts, options[name])
	}
}

function parseCli(raw) {
	opt = raw.options
	parts = []
	swallowed(opt, "dry-run", parts)
	swallowed(opt, "yes", parts)
	swallowed(opt, "explain", parts)
	for (p in raw.positionals) {
		arrayAppend(parts, p)
	}
	return {
		version: flagOn(opt, "interpret-version") || flagOn(opt, "version") || flagOn(opt, "v"),
		help: flagOn(opt, "interpret-help") || flagOn(opt, "help") || flagOn(opt, "h"),
		dryRun: flagOn(opt, "n") || flagOn(opt, "dry-run"),
		yes: flagOn(opt, "y") || flagOn(opt, "yes"),
		explain: flagOn(opt, "e") || flagOn(opt, "explain"),
		history: flagOn(opt, "history"),
		request: arrayToList(parts, " ")
	}
}

function jsonObject(text) {
	start = find("{", text)
	if (start < 1) {
		return ""
	}
	last = 0
	i = len(text)
	while (i >= start) {
		if (mid(text, i, 1) == "}") {
			last = i
			break
		}
		i = i - 1
	}
	if (last < 1) {
		return ""
	}
	return mid(text, start, last - start + 1)
}

function failAction(message) {
	return { type: "Fail", message: message }
}

function parseAction(text) {
	blob = jsonObject(text)
	if (blob == "") {
		snippet = trim(left(text, 200))
		if (snippet == "") {
			return failAction("model did not return JSON (empty content)")
		}
		return failAction("model did not return JSON: " & snippet)
	}
	try {
		action = deserializeJSON(blob)
	} catch (e) {
		return failAction("model returned invalid JSON: " & left(blob, 240))
	}
	if (!structKeyExists(action, "type") && structKeyExists(action, "command")) {
		action.type = "ExecuteCommand"
	}
	if (!structKeyExists(action, "type")) {
		return failAction("model response missing type")
	}
	if (action.type == "ExecuteCommand") {
		if (!structKeyExists(action, "command") || trim(action.command) == "") {
			return failAction("model returned an empty command")
		}
		return action
	}
	if (action.type == "Fail") {
		if (!structKeyExists(action, "message") || trim(action.message) == "") {
			action.message = "failed"
		}
		return action
	}
	if (action.type == "AskQuestion") {
		if (!structKeyExists(action, "question") || trim(action.question) == "") {
			action.question = "Choose:"
		}
		if (!structKeyExists(action, "choices")) {
			action.choices = []
		}
		return action
	}
	if (action.type == "InspectEnvironment") {
		if (!structKeyExists(action, "operation") || trim(action.operation) == "") {
			return failAction("InspectEnvironment missing operation")
		}
		return action
	}
	return failAction("unsupported action: " & action.type)
}

function modelName() {
	name = getSystemSetting("INTERPRET_MODEL", "")
	if (name == "") {
		name = getSystemSetting("OPENAI_MODEL", "gpt-4o-mini")
	}
	return name
}

function apiKey() {
	key = getSystemSetting("INTERPRET_API_KEY", "")
	if (key == "") {
		key = getSystemSetting("OPENAI_API_KEY", "")
	}
	return key
}

function endpoint() {
	base = getSystemSetting("INTERPRET_BASE_URL", "")
	if (base == "") {
		base = getSystemSetting("OPENAI_BASE_URL", "https://api.openai.com/v1")
	}
	if (right(base, 1) == "/") {
		base = left(base, len(base) - 1)
	}
	if (findNoCase("chat/completions", base) > 0 || findNoCase("/responses", base) > 0) {
		return base
	}
	return base & "/chat/completions"
}

function parseHint(request) {
	colon = find(":", request)
	if (colon > 1) {
		next = (colon < len(request)) ? mid(request, colon + 1, 1) : " "
		tool = trim(left(request, colon - 1))
		if (next == " " && tool != "" && find(" ", tool) < 1 && len(tool) < 40) {
			return { tool: tool, request: trim(mid(request, colon + 1, len(request))) }
		}
	}
	return { tool: "", request: request }
}

function gitContext() {
	inside = systemExecute("git", ["rev-parse", "--is-inside-work-tree"])
	if (isNull(inside.exitCode) || inside.exitCode != 0 || trim(inside.output) != "true") {
		return ""
	}
	branch = trim(systemExecute("git", ["branch", "--show-current"]).output)
	status = trim(systemExecute("git", ["status", "-sb"]).output)
	return "git.repo=yes git.branch=" & branch & " git.status=" & status
}

function ambient() {
	return "os=" & trim(systemExecute("uname", ["-s"]).output)
		& " shell=" & getSystemSetting("SHELL", "")
		& " user=" & getSystemSetting("USER", "")
		& " cwd=" & expandPath(".")
		& " " & gitContext()
}

function systemPrompt(tool) {
	nl = chr(10)
	prompt = "You convert one user intent into a shell command." & nl
		& "Reply with a single JSON object and nothing else. No markdown fences. No thinking." & nl
		& "Honor requested units, flags, and constraints exactly. ls -lh is not megabytes." & nl
		& "Include riskFactor 0-10 (10 = worst). Use 7+ for delete, overwrite, privilege, or hard-to-undo." & nl
		& "You may send {""type"":""InspectEnvironment"",""operation"":""command_help"",""arguments"":""ls""} with operation one of get_platform, get_shell, get_cwd, command_exists, command_version, command_help, git_context." & nl
		& "Prefer a reasonable reversible command over asking." & nl
		& "Ask only when the target, command, risk, or data would change." & nl
		& "Do not ask about compression format. Do not ask for permission to run." & nl
		& "Ambient: " & ambient() & nl
	if (tool != "") {
		prompt = prompt & "Use only this tool: " & tool & "." & nl
	}
	execEx = serializeJSON({ type: "ExecuteCommand", command: "ls -l --block-size=M", explanation: "sizes in megabytes", risk: ["READ"], riskFactor: 1 })
	duEx = serializeJSON({ type: "ExecuteCommand", command: "du -ah . | sort -hr | head -10", explanation: "ten largest files", risk: ["READ"] })
	askEx = serializeJSON({ type: "AskQuestion", question: "What should be reset?", choices: ["Working tree", "Last commit"] })
	prompt = prompt & nl
		& "Format examples:" & nl
		& "User: ls with file size in mb" & nl & execEx & nl
		& "User: show the ten largest files here" & nl & duEx & nl
		& "User: reset my git changes" & nl & askEx & nl
		& "Your reply must start with { and end with }."
	return prompt
}

function chat(messages) {
	body = serializeJSON({
		model: modelName(),
		temperature: 0,
		messages: messages
	})
	headers = { "Content-Type": "application/json" }
	key = apiKey()
	if (key != "") {
		headers["Authorization"] = "Bearer " & key
	}
	httpResult = {}
	try {
		httpResult = http({
			url: endpoint(),
			method: "POST",
			headers: headers,
			body: body
		})
	} catch (e) {
		return failAction("LLM request failed: " & e.message)
	}
	if (httpResult.status < 200 || httpResult.status >= 300) {
		return failAction("LLM request failed: " & httpResult.file_content)
	}
	try {
		resp = deserializeJSON(httpResult.file_content)
	} catch (e) {
		return failAction("LLM returned non-JSON")
	}
	if (structKeyExists(resp, "error")) {
		msg = serializeJSON(resp.error)
		if (structKeyExists(resp.error, "message")) {
			msg = resp.error.message
		}
		return failAction(msg)
	}
	if (!structKeyExists(resp, "choices") || arrayLen(resp.choices) < 1) {
		return failAction("LLM returned no choices")
	}
	return parseAction(messageText(resp.choices[1].message))
}

function messageText(message) {
	text = ""
	if (structKeyExists(message, "content") && !isNull(message.content)) {
		text = message.content
	}
	if (find("{", text) < 1 && structKeyExists(message, "reasoning_content") && !isNull(message.reasoning_content)) {
		text = message.reasoning_content
	}
	return text
}

function paint(text, risky) {
	code = risky ? "31" : "32"
	return chr(27) & "[" & code & "m" & text & chr(27) & "[0m"
}

function tagHas(tags, name) {
	for (t in tags) {
		if (uCase(trim(t)) == name) {
			return true
		}
	}
	return false
}

function addTag(tags, name) {
	if (!tagHas(tags, name)) {
		arrayAppend(tags, name)
	}
}

function detectRisk(command) {
	tags = []
	warn = ""
	if (reFindNoCase("(^|[|;[:space:]])rm[[:space:]]+(-[A-Za-z]*r|--recursive)", command) > 0) {
		addTag(tags, "DESTRUCTIVE")
		warn = "Recursive delete."
	}
	if (findNoCase("git reset --hard", command) > 0) {
		addTag(tags, "DESTRUCTIVE")
		warn = "Discards commits and working-tree changes."
	}
	if (findNoCase("git clean", command) > 0) {
		addTag(tags, "DESTRUCTIVE")
		warn = "Deletes untracked files and directories."
	}
	if (findNoCase("git push --force", command) > 0 || findNoCase("git push -f", command) > 0) {
		addTag(tags, "DESTRUCTIVE")
		warn = "Overwrites remote history."
	}
	if (findNoCase("mkfs", command) > 0 || findNoCase("fdisk", command) > 0 || findNoCase("wipefs", command) > 0) {
		addTag(tags, "DESTRUCTIVE")
		warn = "Formats or rewrites a filesystem."
	}
	if (reFindNoCase("(^|[|;[:space:]])dd[[:space:]]", command) > 0) {
		addTag(tags, "DESTRUCTIVE")
		warn = "Low-level disk write."
	}
	if (findNoCase("drop table", command) > 0 || findNoCase("drop database", command) > 0 || findNoCase("truncate ", command) > 0) {
		addTag(tags, "DESTRUCTIVE")
		warn = "Destructive database operation."
	}
	if (reFindNoCase("(^|[|;[:space:]])sudo[[:space:]]", command) > 0) {
		addTag(tags, "PRIVILEGED")
		if (warn == "") {
			warn = "Privileged command."
		}
	}
	return { tags: tags, warning: warn }
}

function mergeRisk(command, action) {
	detected = detectRisk(command)
	tags = detected.tags
	if (structKeyExists(action, "risk") && !isNull(action.risk) && !isSimpleValue(action.risk)) {
		for (t in action.risk) {
			addTag(tags, uCase(trim(t)))
		}
	} else if (structKeyExists(action, "risk") && isSimpleValue(action.risk) && action.risk != false && action.risk != true) {
		addTag(tags, uCase(trim(action.risk)))
	}
	factor = 0
	if (structKeyExists(action, "riskFactor") && isNumeric(action.riskFactor)) {
		factor = action.riskFactor
	}
	risky = tagHas(tags, "DESTRUCTIVE") || tagHas(tags, "PRIVILEGED") || factor >= RISK_THRESHOLD
	warn = detected.warning
	if (risky && warn == "") {
		warn = (factor >= RISK_THRESHOLD) ? ("Model riskFactor " & factor & "/10.") : "Dangerous command."
	}
	return { tags: tags, risky: risky, warning: warn, factor: factor }
}

function tokenizeCommand(command) {
	tokens = []
	buf = ""
	quote = ""
	i = 1
	n = len(command)
	while (i <= n) {
		ch = mid(command, i, 1)
		two = (i < n) ? mid(command, i, 2) : ""
		if (quote == "") {
			if (ch == "'" || ch == '"') {
				quote = ch
				buf = buf & ch
				i = i + 1
				continue
			}
			if (two == "&&" || two == "||") {
				if (buf != "") {
					arrayAppend(tokens, buf)
					buf = ""
				}
				arrayAppend(tokens, two)
				i = i + 2
				continue
			}
			if (ch == "|" || ch == ";") {
				if (buf != "") {
					arrayAppend(tokens, buf)
					buf = ""
				}
				arrayAppend(tokens, ch)
				i = i + 1
				continue
			}
			if (ch == " " || ch == chr(9)) {
				if (buf != "") {
					arrayAppend(tokens, buf)
					buf = ""
				}
				i = i + 1
				continue
			}
		} else if (ch == quote) {
			buf = buf & ch
			quote = ""
			i = i + 1
			continue
		}
		buf = buf & ch
		i = i + 1
	}
	if (buf != "") {
		arrayAppend(tokens, buf)
	}
	return tokens
}

function tokenMeaning(tok, expectCmd) {
	t = lcase(tok)
	if (t == "&&") {
		return "run next only if previous succeeds"
	}
	if (t == "||") {
		return "run next only if previous fails"
	}
	if (t == "|") {
		return "pipe stdout into the next command"
	}
	if (t == ";") {
		return "run next regardless of previous status"
	}
	if (expectCmd && left(tok, 1) != "-") {
		return "program"
	}
	if (left(tok, 1) == "-") {
		return "option"
	}
	return "argument"
}

function localParts(command) {
	parts = []
	expectCmd = true
	for (tok in tokenizeCommand(command)) {
		arrayAppend(parts, { token: tok, meaning: tokenMeaning(tok, expectCmd) })
		if (tok == "|" || tok == "&&" || tok == "||" || tok == ";") {
			expectCmd = true
		} else if (expectCmd && left(tok, 1) != "-") {
			expectCmd = false
		}
	}
	return parts
}

function teachParts(command, action) {
	stub = getSystemSetting("INTERPRET_STUB_TEACH", "")
	if (stub != "") {
		try {
			return deserializeJSON(stub)
		} catch (e) {
		}
	}
	if (structKeyExists(action, "parts") && !isSimpleValue(action.parts)) {
		try {
			if (arrayLen(action.parts) > 0) {
				return action.parts
			}
		} catch (e) {
		}
	}
	return localParts(command)
}

function printTeach(command, action) {
	parts = teachParts(command, action)
	width = 4
	for (p in parts) {
		tok = structKeyExists(p, "token") ? toString(p.token) : ""
		if (len(tok) > width) {
			width = len(tok)
		}
	}
	println("")
	for (p in parts) {
		tok = structKeyExists(p, "token") ? toString(p.token) : ""
		meaning = structKeyExists(p, "meaning") ? toString(p.meaning) : ""
		pad = tok
		while (len(pad) < width) {
			pad = pad & " "
		}
		println("  " & pad & "  " & meaning)
	}
	println("")
}

function confirmRun(risky, command, action) {
	prompt = risky ? "Run? [y/N/e/?/t] " : "Run? [Enter/e/q/t] "
	while (true) {
		answer = lcase(trim(cliRead(paint(prompt, risky))))
		if (answer == "") {
			return risky ? "no" : "yes"
		}
		if (answer == "y") {
			return "yes"
		}
		if (answer == "q" || answer == "n") {
			return "no"
		}
		if (answer == "e") {
			return "edit"
		}
		if (answer == "?") {
			return "explain"
		}
		if (answer == "t") {
			printTeach(command, action)
		}
	}
}

function editCommand(command) {
	editor = getSystemSetting("VISUAL", "")
	if (editor == "") {
		editor = getSystemSetting("EDITOR", "vi")
	}
	path = getTempDirectory() & "interpret-" & createUUID() & ".sh"
	fileWrite(path, command)
	result = systemExecute("sh", ["-c", editor & ' "$1"', "edit", path], 0, false, null, null, null, true, {}, true)
	if (isNull(result.exitCode) || result.exitCode != 0) {
		return ""
	}
	return trim(fileRead(path))
}

function emitOrRun(command) {
	dest = getSystemSetting("INTERPRET_EMIT", "")
	if (dest != "") {
		fileWrite(dest, command & chr(10))
		return { exitCode: 0, output: "", error: "" }
	}
	return runCommand(command)
}

function runCommand(command) {
	result = systemExecute("sh", ["-c", command])
	out = ""
	err = ""
	if (!isNull(result.output)) {
		out = result.output
	}
	if (!isNull(result.error)) {
		err = result.error
	}
	if (out != "") {
		systemOutput(out, right(out, 1) != chr(10), false)
	}
	if (err != "") {
		systemOutput(err, right(err, 1) != chr(10), true)
	}
	code = isNull(result.exitCode) ? 1 : result.exitCode
	return { exitCode: code, output: out, error: err }
}

function showExplanation(action) {
	text = ""
	if (structKeyExists(action, "explanation") && !isNull(action.explanation)) {
		text = trim(action.explanation)
	}
	if (text == "") {
		text = "(no explanation)"
	}
	println(text)
}

function historyFile() {
	dir = getSystemSetting("INTERPRET_HOME", "")
	if (dir == "") {
		dir = getSystemSetting("HOME", "/tmp") & "/.interpret"
	}
	if (!directoryExists(dir)) {
		directoryCreate(dir)
	}
	return dir & "/history.jsonl"
}

function historyAppend(request, command, code) {
	try {
		path = historyFile()
		id = 1
		if (fileExists(path)) {
			existing = fileRead(path)
			id = listLen(existing, chr(10)) + 1
		}
		rec = serializeJSON({
			id: id,
			time: toString(now()),
			cwd: expandPath("."),
			request: request,
			command: command,
			exit: code
		})
		fileAppend(path, rec & chr(10))
	} catch (e) {
	}
}

function historyShow() {
	path = historyFile()
	if (!fileExists(path)) {
		return
	}
	raw = fileRead(path)
	n = listLen(raw, chr(10))
	i = n
	while (i >= 1) {
		line = trim(listGetAt(raw, i, chr(10)))
		i = i - 1
		if (line == "") {
			continue
		}
		try {
			rec = deserializeJSON(line)
			println(rec.id & "  " & rec.request)
			println("    " & rec.command)
		} catch (e) {
		}
	}
}

function repairCommand(intent, command, ran) {
	stub = getSystemSetting("INTERPRET_STUB_REPAIR", "")
	if (stub != "") {
		return parseAction(stub)
	}
	note = "The command failed. Propose a repaired ExecuteCommand JSON."
		& " exit=" & ran.exitCode
		& " stdout=" & left(ran.output, 2000)
		& " stderr=" & left(ran.error, 2000)
		& " Ambient: " & ambient()
	return chat([
		{ role: "system", content: systemPrompt("") },
		{ role: "user", content: intent },
		{ role: "assistant", content: serializeJSON({ type: "ExecuteCommand", command: command }) },
		{ role: "user", content: note }
	])
}

function inspectArg(action) {
	if (structKeyExists(action, "name") && isSimpleValue(action.name)) {
		return trim(action.name)
	}
	if (!structKeyExists(action, "arguments")) {
		return ""
	}
	a = action.arguments
	if (isSimpleValue(a)) {
		return trim(a)
	}
	if (structKeyExists(a, "name")) {
		return trim(a.name)
	}
	try {
		return trim(a[1])
	} catch (e) {
		return ""
	}
}

function safeBin(name) {
	if (name == "" || reFind("[^A-Za-z0-9._+-]", name) > 0) {
		return ""
	}
	return name
}

function runInspect(action) {
	op = lcase(trim(action.operation))
	arg = inspectArg(action)
	if (op == "get_platform") {
		return { ok: true, operation: op, result: trim(systemExecute("uname", ["-s"]).output) }
	}
	if (op == "get_shell") {
		return { ok: true, operation: op, result: getSystemSetting("SHELL", "") }
	}
	if (op == "get_cwd") {
		return { ok: true, operation: op, result: expandPath(".") }
	}
	if (op == "git_context") {
		return { ok: true, operation: op, result: gitContext() }
	}
	bin = safeBin(arg)
	if (op == "command_exists" || op == "command_version" || op == "command_help") {
		if (bin == "") {
			return { ok: false, operation: op, error: "invalid command name" }
		}
		flag = (op == "command_exists") ? "" : ((op == "command_version") ? "--version" : "--help")
		if (op == "command_exists") {
			r = systemExecute("sh", ["-c", 'command -v "$1"', "sh", bin])
			return { ok: true, operation: op, result: (!isNull(r.exitCode) && r.exitCode == 0) }
		}
		r = systemExecute(bin, [flag])
		out = ""
		if (!isNull(r.output)) {
			out = r.output
		}
		if (out == "" && !isNull(r.error)) {
			out = r.error
		}
		return { ok: !isNull(r.exitCode) && r.exitCode == 0, operation: op, result: left(out, 4000) }
	}
	return { ok: false, operation: op, error: "not allowlisted" }
}

function loadStubs() {
	many = getSystemSetting("INTERPRET_STUB_ACTIONS", "")
	if (many != "") {
		return deserializeJSON(many)
	}
	one = getSystemSetting("INTERPRET_STUB_ACTION", "")
	if (one != "") {
		return [deserializeJSON(one)]
	}
	return []
}

function questionKind(action) {
	if (structKeyExists(action, "questionType")) {
		return lcase(trim(action.questionType))
	}
	if (structKeyExists(action, "kind")) {
		return lcase(trim(action.kind))
	}
	return ""
}

function ask(action) {
	stub = getSystemSetting("INTERPRET_STUB_ANSWER", "")
	kind = questionKind(action)
	free = kind == "freetext" || kind == "free" || kind == "text" || arrayLen(action.choices) == 0
	if (free) {
		if (stub != "") {
			return stub
		}
		line = trim(cliRead(action.question & " "))
		return (line == "") ? "cancel" : line
	}
	choices = []
	allowOther = (structKeyExists(action, "allow_other") && action.allow_other) || (structKeyExists(action, "allowOther") && action.allowOther)
	for (c in action.choices) {
		arrayAppend(choices, c)
		if (lcase(trim(c)) == "other" || lcase(trim(c)) == "other…" || lcase(trim(c)) == "other...") {
			allowOther = true
		}
	}
	hasCancel = false
	for (c in choices) {
		if (lcase(trim(c)) == "cancel") {
			hasCancel = true
		}
	}
	if (!hasCancel) {
		arrayAppend(choices, "Cancel")
	}
	if (allowOther) {
		hasOther = false
		for (c in choices) {
			if (lcase(left(trim(c), 5)) == "other") {
				hasOther = true
			}
		}
		if (!hasOther) {
			arrayAppend(choices, "Other…")
		}
	}
	if (stub != "") {
		return stub
	}
	picked = cliSelect(action.question, choices)
	if (lcase(left(trim(picked), 5)) == "other") {
		line = trim(cliRead("> "))
		return (line == "") ? "cancel" : line
	}
	return picked
}

function resolve(request) {
	hint = parseHint(request)
	if (getSystemSetting("INTERPRET_DUMP_CONTEXT", "") != "") {
		systemOutput(ambient(), true, true)
	}
	stubs = loadStubs()
	if (hint.tool != "" && arrayLen(stubs) == 0) {
		found = runInspect({ operation: "command_exists", arguments: hint.tool })
		if (!found.result) {
			return failAction(hint.tool & " not found")
		}
	}
	intent = hint.request
	if (hint.tool != "") {
		intent = "Use only the " & hint.tool & " command. Do not substitute another program. Intent: " & hint.request
	}
	example = serializeJSON({
		type: "ExecuteCommand",
		command: "ls -l --block-size=M",
		explanation: "sizes in megabytes",
		risk: ["READ"],
		riskFactor: 1
	})
	messages = [
		{ role: "system", content: systemPrompt(hint.tool) },
		{ role: "user", content: "ls with file size in mb" },
		{ role: "assistant", content: example },
		{ role: "user", content: intent }
	]
	if (hint.tool != "") {
		messages = [
			{ role: "system", content: systemPrompt(hint.tool) },
			{ role: "user", content: intent }
		]
	}
	at = 1
	inspects = 0
	turns = 0
	while (turns < 8) {
		turns = turns + 1
		if (at <= arrayLen(stubs)) {
			action = parseAction(serializeJSON(stubs[at]))
			at = at + 1
		} else if (arrayLen(stubs) > 0) {
			return failAction("no more stub actions")
		} else {
			action = chat(messages)
		}
		if (action.type == "AskQuestion") {
			answer = ask(action)
			if (lcase(trim(answer)) == "cancel") {
				return failAction("cancelled")
			}
			arrayAppend(messages, { role: "assistant", content: serializeJSON(action) })
			arrayAppend(messages, { role: "user", content: answer })
		} else if (action.type == "InspectEnvironment") {
			inspects = inspects + 1
			if (inspects > 4) {
				return failAction("too many inspects")
			}
			arrayAppend(messages, { role: "assistant", content: serializeJSON(action) })
			arrayAppend(messages, { role: "user", content: serializeJSON(runInspect(action)) })
		} else {
			return action
		}
	}
	return failAction("too many questions")
}

function main() {
	parsed = parseCli(cliGetArgs())
	if (parsed.version) {
		println("interpret " & VERSION)
		cliExit(0)
	}
	if (parsed.help) {
		usage()
		cliExit(0)
	}
	if (parsed.history) {
		historyShow()
		cliExit(0)
	}
	if (trim(parsed.request) == "") {
		usage()
		cliExit(2)
	}
	action = resolve(parsed.request)
	if (action.type != "ExecuteCommand") {
		systemOutput(action.message, true, true)
		cliExit(1)
	}
	command = action.command
	risk = mergeRisk(command, action)
	if (!parsed.dryRun) {
		println("")
	}
	println(parsed.dryRun ? command : paint(command, risk.risky))
	if (parsed.explain) {
		showExplanation(action)
	}
	if (parsed.dryRun) {
		cliExit(0)
	}
	if (risk.risky && risk.warning != "") {
		println(paint("⚠ " & risk.warning, true))
	}
	ran = { exitCode: 1, output: "", error: "" }
	if (parsed.yes && !risk.risky) {
		println("")
		ran = emitOrRun(command)
	} else {
		while (true) {
			choice = confirmRun(risk.risky, command, action)
			if (choice == "explain") {
				showExplanation(action)
				continue
			}
			if (choice == "edit") {
				edited = editCommand(command)
				if (edited == "") {
					continue
				}
				command = edited
				risk = mergeRisk(command, {})
				println("")
				println(paint(command, risk.risky))
				if (risk.risky && risk.warning != "") {
					println(paint("⚠ " & risk.warning, true))
				}
				continue
			}
			if (choice != "yes") {
				cliExit(1)
			}
			println("")
			ran = emitOrRun(command)
			break
		}
	}
	historyAppend(parsed.request, command, ran.exitCode)
	if (ran.exitCode != 0) {
		fix = lcase(trim(cliRead("[r] Repair  [e] Edit  [q] Quit ")))
		if (fix == "r") {
			repaired = repairCommand(parsed.request, command, ran)
			if (repaired.type != "ExecuteCommand") {
				systemOutput(repaired.message, true, true)
				cliExit(1)
			}
			command = repaired.command
			action = repaired
			risk = mergeRisk(command, action)
			println("")
			println(paint(command, risk.risky))
			if (parsed.explain) {
				showExplanation(action)
			}
			if (risk.risky && risk.warning != "") {
				println(paint("⚠ " & risk.warning, true))
			}
			choice = confirmRun(risk.risky, command, action)
			if (choice == "yes") {
				println("")
				ran = emitOrRun(command)
				historyAppend(parsed.request, command, ran.exitCode)
			}
		} else if (fix == "e") {
			edited = editCommand(command)
			if (edited != "") {
				command = edited
				println("")
				println(paint(command, mergeRisk(command, {}).risky))
				choice = confirmRun(mergeRisk(command, {}).risky, command, action)
				if (choice == "yes") {
					println("")
					ran = emitOrRun(command)
					historyAppend(parsed.request, command, ran.exitCode)
				}
			}
		}
	}
	cliExit(ran.exitCode)
}

main()
